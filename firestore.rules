rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    // The one account allowed to change the admin list. Hardcoded on purpose:
    // an owner flag stored in Firestore would only be as strong as the weakest
    // write path into Firestore. Mirrored by OWNER_EMAIL in lib/owner.ts —
    // change both together.
    function isOwner() {
      return isAuthenticated() && tokenEmail() == '818038@seq.org';
    }

    // Admins are keyed by sanitized email, not uid, so an admin can be added
    // before they have ever signed in — a uid does not exist until then.
    // Mirrors adminDocId() in lib/owner.ts.
    function adminDocId() {
      return tokenEmail().replace('@', '_at_').replace('[.]', '_');
    }

    function hasAdminRow() {
      return isAuthenticated()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(adminDocId()));
    }

    // Rows written before roles existed carry no role field and are full
    // admins. lib/roles.ts normalizeRole() defaults the same way.
    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(adminDocId()))
               .data.get('role', 'admin');
    }

    // A chair may create events and nothing else. Everything guarded by
    // isAdmin() below — the roster, check-ins, sign-ups, the admin list — is
    // student PII or dashboard-wide state they have no reason to hold.
    function isChair() {
      return !isOwner() && hasAdminRow() && adminRole() == 'chair';
    }

    // The owner is always a full admin, whether or not a row exists for them.
    // This is what makes lockout impossible: deleting every document in
    // /admins still leaves one account that can sign in and rebuild the list.
    function isAdmin() {
      return isOwner() || (hasAdminRow() && adminRole() != 'chair');
    }

    // Mirrors AuthService.sanitize() and sanitizeEmail(): a.b@x.org -> a_b_at_x_org.
    // replace() takes a regex and rewrites every match, so the dot is escaped as
    // a character class — a bare '.' matches every character and would reduce
    // the whole address to underscores.
    function studentDocId() {
      return tokenEmail().replace('@', '_at_').replace('[.]', '_');
    }

    function studentData() {
      return get(/databases/$(database)/documents/students/$(studentDocId())).data;
    }

    // Whitelist removal has to take effect for sessions that are already open.
    // The app only consults the whitelist during interactive sign-in, and a
    // restored session never rechecks it, so this is the only thing standing
    // between a removed student and continued access.
    function isWhitelisted() {
      return isAuthenticated()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/students/$(studentDocId()))
        && studentData().isWhitelisted == true;
    }

    // Demo accounts (admin@flockin.local and friends) deliberately have no
    // student record. REMOVE this function, the Firebase users, and
    // AuthService.staffUsernames together once App Review is finished.
    function isStaffAccount() {
      return isAuthenticated()
        && request.auth.token.email is string
        && tokenEmail().matches('.*@flockin[.]local');
    }

    function isEnrolled() {
      return isWhitelisted() || isStaffAccount();
    }

    // Matches the signed-in user against a student record by its stored email
    // rather than by rebuilding the document ID from the token.
    function isSelfStudent() {
      return isAuthenticated()
        && request.auth.token.email is string
        && resource.data.email is string
        && resource.data.email.lower() == tokenEmail();
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function signupData(signupId) {
      return get(/databases/$(database)/documents/signups/$(signupId)).data;
    }

    // ── Events ───────────────────────────────────────────────────────────
    // Any signed-in student can read events.
    // Admins and chairs can create them; only admins can edit or delete.
    // "Chair" is the create-only role, so editing an event after the fact —
    // including flipping isActive, which is what releases check-in — stays with
    // full admins.
    match /events/{eventId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin() || isChair();
      allow update, delete: if isAdmin();
    }

    // ── Event authorship ─────────────────────────────────────────────────
    // Who created each event, keyed by the event's own ID.
    //
    // Kept out of the event document on purpose. Firestore permissions are
    // per-document, not per-field, and every signed-in student can read
    // /events — so a createdBy field on the event itself would be readable by
    // the whole school even though the app never displays it. A sibling
    // collection is the only way to record this and still keep it from
    // students.
    match /eventMeta/{eventId} {
      allow read: if isAdmin();

      // Written by whoever creates the event, chairs included — they are the
      // main reason this log exists. createdBy is pinned to the caller's own
      // verified token, so nobody can file an event under someone else's name.
      allow create: if (isAdmin() || isChair())
        && request.resource.data.createdBy == tokenEmail();

      allow update, delete: if isAdmin();
    }

    // ── Students whitelist ───────────────────────────────────────────────
    match /students/{studentId} {
      // Previously any signed-in user could read the whole roster — every
      // student's name, email, and FCM push token. Sign-in only ever needs the
      // caller's own record, and the dashboard reads the collection as admin.
      // The caller's own record has to be readable by document ID, not only via
      // isSelfStudent(): that helper reads resource.data.email, and a document
      // that does not exist has no resource. Without this, a student who was
      // never imported gets "Missing or insufficient permissions" at sign-in
      // instead of the app's "not registered" message. Reading by ID exposes
      // nothing extra — the ID is derived from the caller's own token email.
      allow read:   if isAdmin() || isSelfStudent()
        || (isAuthenticated()
            && request.auth.token.email is string
            && studentId == studentDocId());
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSelfStudent()
            // Students can only update safe fields (token, lastSignIn).
            // isWhitelisted and email stay off this list — those are the
            // advisor's to set, so the app must not write them either.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fcmToken', 'lastSignIn', 'displayName', 'uid']));
      allow delete: if isAdmin();
    }

    // ── Signups ──────────────────────────────────────────────────────────
    match /signups/{signupId} {
      allow read:   if isAuthenticated()
        && (resource.data.studentUid == request.auth.uid || isAdmin());

      // Sign-ups are created only by POST /api/signup, which runs with Admin
      // SDK credentials and therefore bypasses these rules. It is the only
      // place that can enforce an event's spot limit: that means counting a
      // event's sign-ups, which rules cannot do and which a student has no
      // permission to do either (see the read rule above).
      //
      // Denying creates here is what makes that endpoint authoritative rather
      // than merely advisory — otherwise the app could write the document
      // itself and skip the capacity check entirely.
      //
      // The endpoint also builds the denormalized event snapshot from the
      // event document server-side, so eventHours cannot be inflated by the
      // caller. Document IDs are "{eventId}_{studentUid}", which keeps a
      // student to one sign-up per event.
      allow create: if false;

      // Students may only flip the check-in flag. Every other field — above all
      // eventHours — is frozen once written.
      allow update: if isAdmin()
        || (isAuthenticated()
            && resource.data.studentUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isCheckedIn', 'checkedInAt'])
            && eventData(resource.data.eventId).isActive == true);

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
    }

    // ── Check-ins ────────────────────────────────────────────────────────
    // Check-ins are what volunteer hours are computed from, so this is the
    // collection worth attacking. The client picks none of the values that
    // matter: hours come from the signup snapshot, which was itself pinned to
    // the event at signup time.
    match /checkins/{checkinId} {
      allow read:   if isAuthenticated()
        && (resource.data.studentUid == request.auth.uid || isAdmin());

      // The document ID is the signup ID, so one signup yields at most one
      // check-in. Otherwise a student could mint unlimited hours simply by
      // repeating a legitimate write.
      allow create: if isEnrolled()
        && request.resource.data.studentUid == request.auth.uid
        && checkinId == request.resource.data.signupId
        && exists(/databases/$(database)/documents/signups/$(checkinId))
        && signupData(checkinId).studentUid == request.auth.uid
        && request.resource.data.eventId == signupData(checkinId).eventId
        && request.resource.data.hoursEarned == signupData(checkinId).eventHours
        // The admin must have activated the event.
        //
        // NOTE: the geofence (LocationManager.checkInRadiusMeters, currently
        // 250m) cannot be enforced here. Location is only
        // ever asserted by the client, so any server-side check would just be
        // trusting a number the device chose. Activation plus one-check-in-per
        // -signup is the part that can actually be enforced; the geofence
        // remains a convenience control, not a security one.
        && eventData(request.resource.data.eventId).isActive == true;

      allow update, delete: if isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────────
    // Only existing admins can read the admins list.
    //
    // Writes are closed to every client, including the owner's browser. Adding
    // and removing admins goes through /api/admins, which runs with Admin SDK
    // credentials and checks the caller's verified token email against
    // OWNER_EMAIL. Granting the owner write access here instead would mean any
    // XSS on the dashboard could appoint admins straight from the owner's own
    // session; routing it through the server keeps privilege escalation behind
    // a request the server gets to inspect.
    match /admins/{adminId} {
      // Anyone signed in may read their own row, so the dashboard can find out
      // that it is NOT an admin without being denied. Checking isAdmin() alone
      // required already being an admin to ask the question, which surfaced a
      // raw permissions error on the login screen for every non-admin.
      allow read:  if isAdmin() || (isAuthenticated() && adminId == adminDocId());
      allow write: if false;
    }
  }
}
